[Unit]
Description=Download new at-chat backups from the production server and check the newest one
Documentation=file:%h/at-chat/scripts/backup-downloader/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# Runs the program compiled by `npm run backup-downloader` (see README). Rebuild
# whenever at-chat's Types.elm changes, otherwise backups won't decode.
ExecStart=/usr/bin/node %h/at-chat/scripts/backup-downloader/run.js

# Configuration (all optional — these are the defaults, shown for reference).
Environment=AT_CHAT_BACKUP_SOURCE=root@at-chat.app:/var/lib/atchat/backups/
Environment=AT_CHAT_BACKUP_DEST=%h/at-chat-backups
# Environment=AT_CHAT_SSH_KEY=%h/.ssh/at-chat-backup

# Don't let a hung transfer run forever.
TimeoutStartSec=1h

migrate_WordSpellingGame_PlacedWord : Evergreen.V360.WordSpellingGame.PlacedWord -> Evergreen.V363.WordSpellingGame.PlacedWord
migrate_WordSpellingGame_PlacedWord old =
    { start = old.start
    , isVertical = old.isVertical
    , letters = old.letters |> migrate_List_Nonempty_Nonempty migrate_WordSpellingGame_LetterOrWildcard
    }


migrate_WordSpellingGame_PlacementResult : Evergreen.V360.WordSpellingGame.PlacementResult -> Evergreen.V363.WordSpellingGame.PlacementResult
migrate_WordSpellingGame_PlacementResult old =
    { words =
        old.words
            |> List.map
                (\rec ->
                    { letters = rec.letters |> List.map migrate_WordSpellingGame_LetterOrWildcard
                    , placedCount = rec.placedCount
                    }
                )
    , score = old.score
    , placedCells = old.placedCells |> List.map (Tuple.mapSecond migrate_WordSpellingGame_LetterOrWildcard)
    }


migrate_WordSpellingGame_Player : Evergreen.V360.WordSpellingGame.Player -> Evergreen.V363.WordSpellingGame.Player
migrate_WordSpellingGame_Player old =
    { userId = old.userId |> migrate_Id_Id
    , tray = old.tray |> migrate_IdArray_IdArray migrate_WordSpellingGame_LetterOrWildcard
    , score = old.score
    , premove = old.premove |> Maybe.map (\( t1, t2, t3 ) -> ( t1 |> migrate_WordSpellingGame_PlacedWord, t2 |> migrate_WordSpellingGame_PlacementResult, t3 |> migrate_WordSpellingGame_IsValid ))
    }


migrate_WordSpellingGame_Shared : Evergreen.V360.WordSpellingGame.Shared -> Evergreen.V363.WordSpellingGame.Shared
migrate_WordSpellingGame_Shared old =

    , discordDirectMentions = old.discordDirectMentions |> SeqDict.toList |> List.map (Tuple.mapBoth migrate_Discord_Id (migrate_NonemptyDict_NonemptyDict (Tuple.mapBoth migrate_Discord_Id migrate_Id_ThreadRoute) migrate_OneOrGreater_OneOrGreater)) |> SeqDict.fromList

                (p1 |> migrate_UserSession_ToBeFilledInByBackend migrate_WordSpellingGame_IsValid)

        Evergreen.V360.WordSpellingGame.ReplaceTrayOrPass ->
            Evergreen.V363.WordSpellingGame.ReplaceTrayOrPass

        Evergreen.V360.WordSpellingGame.JoinGame ->
            Evergreen.V363.WordSpellingGame.JoinGame

        Evergreen.V360.WordSpellingGame.Premove p0 p1 ->
            Evergreen.V363.WordSpellingGame.Premove (p0 |> migrate_WordSpellingGame_PlacedWord)
                (p1 |> migrate_UserSession_ToBeFilledInByBackend migrate_WordSpellingGame_IsValid)

        Evergreen.V360.WordSpellingGame.CancelPremove ->
            Evergreen.V363.WordSpellingGame.CancelPremove


migrate_WordSpellingGame_ActionWithTime : Evergreen.V360.WordSpellingGame.ActionWithTime -> Evergreen.V363.WordSpellingGame.ActionWithTime
migrate_WordSpellingGame_ActionWithTime old =

    , cells = old.cells |> List.map (Tuple.mapSecond migrate_WordSpellingGame_LetterOrWildcard)
    , isValid = old.isValid |> migrate_UserSession_ToBeFilledInByBackend migrate_WordSpellingGame_IsValid
    }



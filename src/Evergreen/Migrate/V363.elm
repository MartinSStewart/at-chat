    , players = old.players |> migrate_List_Nonempty_Nonempty migrate_WordSpellingGame_Player
    , turnCount = old.turnCount
    , passingStartedAt = old.passingStartedAt
    , lastPlacement = old.lastPlacement |> Maybe.map migrate_WordSpellingGame_AnimatedPlacement
    , attemptsLeft = old.attemptsLeft |> migrate_OneOrGreater_OneOrGreater
    }


migrate_WordSpellingGame_ValidatedSetup : Evergreen.V360.WordSpellingGame.ValidatedSetup -> Evergreen.V363.WordSpellingGame.ValidatedSetup
migrate_WordSpellingGame_ValidatedSetup old =
    { timeControls = old.timeControls |> migrate_Go_TimeControl
    , traySize = old.traySize |> migrate_OneOrGreater_OneOrGreater
    , fullTrayBonus = old.fullTrayBonus
    , createdBy = old.createdBy |> migrate_Id_Id
    , seed = old.seed
    , letters =
        old.letters
            |> migrate_NonemptyDict_NonemptyDict migrate_WordSpellingGame_LetterOrWildcard
                (\rec ->
                    { count = rec.count |> migrate_OneOrGreater_OneOrGreater
                    , value = rec.value
                    }
                )
    , language = old.language |> migrate_WordSpellingGame_Language
    , placeWordAttempts = old.placeWordAttempts |> migrate_OneOrGreater_OneOrGreater
    }


